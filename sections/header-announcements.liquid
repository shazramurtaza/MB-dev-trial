

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="
    --padding-block-start: {{ section.settings['padding-block-start'] }}px;
    --padding-block-end: {{ section.settings['padding-block-end'] }}px;
    --announcement-bar-padding-inline-start: {{ section.settings['padding-inline-start'] }}px;
    --announcement-bar-padding-inline-end: {{ section.settings['padding-inline-end'] }}px;
    --border-bottom-width: {{ section.settings.divider_width }}px;
    {% if section.settings.divider_color != blank %}
      --color-border: {{ section.settings.divider_color }};
    {% endif %}
  "
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif

    assign show_store_links = false
    if section.settings.show_app_store_button or section.settings.show_google_play_button
      assign show_store_links = true
    endif
  %}

  <div class="announcement-bar__row">
    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
        {% content_for 'blocks' %}
      </div>
    </announcement-bar-component>

    {% if show_store_links %}
      <div class="announcement-bar__store-links">
        {% if section.settings.show_app_store_button %}
          {% render 'announcement-bar-store-link',
            link: section.settings.app_store_link,
            label: section.settings.app_store_label,
            icon: 'app-store'
          %}
        {% endif %}
        {% if section.settings.show_google_play_button %}
          {% render 'announcement-bar-store-link',
            link: section.settings.google_play_link,
            label: section.settings.google_play_label,
            icon: 'google-play'
          %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);

    /* Below 750px, the merchant's desktop inline padding is capped to the theme's
       standard page margin so long announcement text doesn't wrap excessively;
       the merchant-configured value applies as-is from 750px up. */
    --padding-inline-start: var(--page-margin);
    --padding-inline-end: var(--page-margin);

    @media screen and (min-width: 750px) {
      --padding-inline-start: var(--announcement-bar-padding-inline-start);
      --padding-inline-end: var(--announcement-bar-padding-inline-end);
    }
  }

  .announcement-bar__row {
    max-width: 1360px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    flex: 1 1 auto;
    min-width: 0;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__store-links {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .announcement-bar__store-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 1px 6px 1px 2px;
    background-color: #000;
    border-radius: 2px;
    text-decoration: none;
  }

  /* Expands the tap target to the theme's 44px minimum without growing the visible badge */
  .announcement-bar__store-link::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, var(--minimum-touch-target, 44px));
    height: max(100%, var(--minimum-touch-target, 44px));
    transform: translate(-50%, -50%);
  }

  .announcement-bar__store-icon {
    display: flex;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .announcement-bar__store-label {
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.5;
    color: #fff;
    white-space: nowrap;
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:content.app_links"
    },
    {
      "type": "checkbox",
      "id": "show_app_store_button",
      "label": "t:settings.show_app_store_button",
      "default": true
    },
    {
      "type": "text",
      "id": "app_store_label",
      "label": "t:settings.app_store_label",
      "default": "App Store",
      "visible_if": "{{ section.settings.show_app_store_button }}"
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "t:settings.app_store_link",
      "visible_if": "{{ section.settings.show_app_store_button }}"
    },
    {
      "type": "checkbox",
      "id": "show_google_play_button",
      "label": "t:settings.show_google_play_button",
      "default": true
    },
    {
      "type": "text",
      "id": "google_play_label",
      "label": "t:settings.google_play_label",
      "default": "Google Play",
      "visible_if": "{{ section.settings.show_google_play_button }}"
    },
    {
      "type": "url",
      "id": "google_play_link",
      "label": "t:settings.google_play_link",
      "visible_if": "{{ section.settings.show_google_play_button }}"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
