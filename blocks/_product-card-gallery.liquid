

{% assign product = closest.product %}

{% liquid
  # product.metafields.custom.badge is the metafield; .value resolves it to the
  # referenced "badge" metaobject entry, which is where its fields actually live.
  assign custom_badge = product.metafields.custom.badge.value
  assign custom_badge_label = custom_badge.title
%}

{% capture children %}
  {% unless product == blank %}
    {%- comment -%}
      The overlay is absolutely positioned, so it doesn't shrink to the padded
      image box on its own the way the image itself does - it has to be told the
      same padding explicitly, or its aspect-ratio-derived height drifts from the
      image's actual height and bottom/right-anchored content (badges) drifts
      with it. The badge/wishlist position math below already re-adds this same
      padding on top, so it's zeroed out for their inherited read of it here.
    {%- endcomment -%}
    <div
      class="product-card-media-overlay"
      style="
        inset-inline: {{ block.settings.padding-inline-start | default: 0 }}px {{ block.settings.padding-inline-end | default: 0 }}px;
        inset-block-start: {{ block.settings.padding-block-start | default: 0 }}px;
        --padding-inline-start: 0px;
        --padding-inline-end: 0px;
        --padding-block-start: 0px;
        --padding-block-end: 0px;
      "
    >
      {%- if custom_badge_label != blank or product.available == false or product.compare_at_price > product.price -%}
        <div
          class="product-badges product-badges--{{ settings.badge_position }}"
          style="
              --badge-border-radius: {{ settings.badge_corner_radius }}px;
              --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
          "
        >
          {%- if custom_badge_label != blank -%}
            <div
              class="product-badges__badge product-badges__badge--rectangle"
              style="
                {% if custom_badge.bg_color != blank %}background-color: {{ custom_badge.bg_color }};{% endif %}
                {% if custom_badge.text_color != blank %}color: {{ custom_badge.text_color }};{% endif %}
              "
            >
              {{ custom_badge_label }}
            </div>
          {%- elsif product.available == false -%}
            <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sold-out">
              {{ 'content.product_badge_sold_out' | t }}
            </div>
          {%- elsif product.compare_at_price > product.price -%}
            <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-sale">
              {{ 'content.product_badge_sale' | t }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <button
        type="button"
        class="product-card-wishlist"
        aria-label="{{ 'actions.add_to_wishlist' | t }}"
        aria-pressed="false"
      >
        <span class="svg-wrapper product-card-wishlist__icon product-card-wishlist__icon--outline" aria-hidden="true">
          <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            {%- render 'icon', icon: 'heart' -%}
          </svg>
        </span>
        <span class="svg-wrapper product-card-wishlist__icon product-card-wishlist__icon--filled" aria-hidden="true">
          <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            {%- render 'icon', icon: 'heart-filled' -%}
          </svg>
        </span>
      </button>
    </div>
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

<script type="module" src="{{ 'product-card-wishlist.js' | asset_url }}" fetchpriority="low"></script>

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% stylesheet %}
  .product-card-media-overlay {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    aspect-ratio: var(--gallery-aspect-ratio);
    z-index: 2;
    pointer-events: none;
  }

  .product-card-media-overlay > * {
    pointer-events: auto;
  }

  .product-card .product-badges--bottom-left {
    bottom: 10px;
    left: 10px;
  }

  .product-card .product-badges__badge {
    --badge-font-size: 12px;
    white-space: nowrap;
    padding: 4px;
    line-height: 12px;
    border-radius: 2px;
    font-weight: 500;
  }

  .product-card-wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: rgb(255 255 255 / 0.9);
    border: none;
    border-radius: 50%;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .product-card-wishlist .svg-wrapper {
    display: flex;
    width: 16px;
    height: 16px;
  }

  .product-card-wishlist .product-card-wishlist__icon--filled {
    display: none;
  }

  .product-card-wishlist[aria-pressed='true'] {
    background: #a64a4c;
    color: #fff;
  }

  .product-card-wishlist[aria-pressed='true'] .product-card-wishlist__icon--outline {
    display: none;
  }

  .product-card-wishlist[aria-pressed='true'] .product-card-wishlist__icon--filled {
    display: flex;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
